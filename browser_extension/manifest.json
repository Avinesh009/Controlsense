{
  "manifest_version": 3,
  "name": "Employee Activity Companion",
  "version": "1.0.0",
  "description": "Secure companion extension for corporate active tab & domain telemetry.",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Employee Activity Companion"
  }
}
